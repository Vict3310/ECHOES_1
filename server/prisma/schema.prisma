// ECHOES — PostgreSQL schema.
//
// Design note: curated cultural reference data (places, sources, coverage,
// experiences) is version-controlled in /data and loaded by the API, so that
// every change to a historical record is reviewable in a pull request with its
// provenance intact. User-generated and transactional data — stories, bookings,
// payments, accounts, audit trail — lives here, in the database.
//
// Generate migrations with:  npx prisma migrate dev --name init
// Apply in production with:  npx prisma migrate deploy

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  visitor
  contributor
  organizer
  moderator
  admin
}

enum StoryStatus {
  pending
  approved
  rejected
  needs_correction
}

enum UserStatus {
  active
  suspended
}

enum AttributionPreference {
  full_name
  pseudonym
  anonymous
}

enum SensitivityLevel {
  standard
  sensitive
  restricted
}

enum BookingStatus {
  pending_payment
  confirmed
  failed
  cancelled
  expired
}

enum PaymentStatus {
  initialised
  pending
  successful
  failed
  cancelled
  expired
  mismatched
}

model User {
  id             String               @id @default(uuid())
  email          String               @unique
  name           String
  passwordHash   String
  role           UserRole             @default(visitor)
  // Suspension is reversible and auditable; accounts are never hard-deleted by
  // the dashboard, so the audit trail keeps pointing at something real.
  status         UserStatus           @default(active)
  suspendedAt    DateTime?
  createdAt      DateTime             @default(now())
  stories        Story[]              @relation("StoryReviewer")
  passwordResets PasswordResetToken[]

  @@index([role])
  @@index([status, createdAt])
  @@index([createdAt])
}

/// Single-use password resets. Only the SHA-256 hash of the emailed token is
/// stored, so a database leak cannot be replayed into a working reset link.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, usedAt])
}

model Story {
  id                String                @id @default(uuid())
  reference         String                @unique
  placeId           String?
  suggestedPlace    String?
  body              String
  sourceContext     String
  period            String?
  attribution       AttributionPreference
  contributorName   String?
  contributorEmail  String?
  consentPublication Boolean
  consentTerms      Boolean
  sensitivity       SensitivityLevel      @default(standard)
  mediaUrls         String[]              @default([])
  status            StoryStatus           @default(pending)
  moderationNote    String?
  reviewedById      String?
  reviewedBy        User?                 @relation("StoryReviewer", fields: [reviewedById], references: [id])
  reviewedAt        DateTime?
  createdAt         DateTime              @default(now())

  @@index([placeId, status])
  @@index([status, createdAt])
}

model Booking {
  id             String            @id @default(uuid())
  reference      String            @unique
  experienceId   String
  scheduleId     String
  participants   Int
  unitPriceMinor Int
  totalMinor     Int
  currency       String            @default("NGN")
  status         BookingStatus     @default(pending_payment)
  customerName   String
  customerEmail  String
  customerPhone  String?
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  payments       PaymentAttempt[]

  @@index([scheduleId, status])
  @@index([status, createdAt])
  @@index([customerEmail])
}

model PaymentAttempt {
  id                String        @id @default(uuid())
  bookingId         String
  booking           Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  reference         String        @unique
  providerReference String?
  amountMinor       Int
  currency          String        @default("NGN")
  status            PaymentStatus @default(initialised)
  providerStatus    String?
  checkoutUrl       String?
  // Safe reconciliation metadata only. Raw card data is never stored.
  payload           Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([bookingId])
  @@index([status, createdAt])
}

/// Append-only by policy and by database trigger (see prisma/sql/analytics.sql):
/// an UPDATE or DELETE on this table is rejected outright, so an administrator
/// cannot quietly rewrite what an earlier administrator did.
model AuditLog {
  id         String   @id @default(uuid())
  actor      String
  action     String
  entityType String
  entityId   String
  details    Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

/// Raw first-party analytics events.
///
/// `userId` is a plain column rather than a foreign key: analytics must keep
/// working for anonymous visitors, and erasing an account must not cascade into
/// deleting the record of what the site did. It is deliberately not the visitor
/// identifier — that is a random token, and the two are counted separately.
model AnalyticsEvent {
  id          String   @id
  name        String
  receivedAt  DateTime @default(now())
  occurredAt  DateTime
  visitorId   String?
  sessionId   String?
  userId      String?
  path        String?
  resourceId  String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  device      String   @default("unknown")
  props       Json     @default("{}")
  internal    Boolean  @default(false)

  @@index([occurredAt])
  @@index([name, occurredAt])
  @@index([visitorId, occurredAt])
  @@index([sessionId])
  @@index([userId, occurredAt])
  @@index([resourceId, occurredAt])
  @@index([internal, occurredAt])
}

/// One row per AI request. Prompts and answers are never stored here.
model AiRequest {
  id                  String   @id @default(uuid())
  feature             String
  model               String
  provider            String
  ok                  Boolean
  status              Int
  latencyMs           Int
  promptTokens        Int?
  completionTokens    Int?
  providerCostMinor   Int?
  estimatedCostMicros Int?
  errorKind           String?
  createdAt           DateTime @default(now())

  @@index([createdAt])
  @@index([feature, createdAt])
  @@index([model, createdAt])
}

/// Per-minute request aggregates, not per-request rows.
model RequestMetric {
  id            String   @id @default(uuid())
  bucket        DateTime
  route         String
  method        String
  count         Int      @default(0)
  serverErrors  Int      @default(0)
  clientErrors  Int      @default(0)
  latencySumMs  Int      @default(0)
  latencyMaxMs  Int      @default(0)
  histogram     Int[]    @default([])

  @@unique([bucket, route, method])
  @@index([bucket])
}
