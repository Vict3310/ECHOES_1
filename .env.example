# ============================================================================
# ECHOES — environment configuration
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# Anything prefixed with VITE_ is shipped to the browser: never put secrets there.
# ============================================================================

# --- Server -----------------------------------------------------------------
NODE_ENV=development
PORT=8787
# Comma-separated list of allowed browser origins (CORS).
CORS_ORIGINS=http://localhost:5173

# --- Database (PostgreSQL + PostGIS + Prisma) --------------------------------
# When DATABASE_URL is unset the API runs on an in-memory repository seeded from
# /data so that discovery, moderation and booking flows stay testable offline.
DATABASE_URL=postgresql://echoes:echoes@localhost:5432/echoes?schema=public

# --- Authentication ----------------------------------------------------------
# HS256 signing secret for user sessions. Generate: openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-string
# Shared secret required by /api/admin/* endpoints (admin token auth).
ADMIN_API_TOKEN=replace-with-an-admin-token

# --- Gemma (PRIMARY AI MODEL) ------------------------------------------------
# Provider: "google" (Google AI Studio / Gemini API Gemma endpoint),
#           "ollama" (self-hosted local inference), or "none" (offline grounded
#           retrieval only — no language model calls).
GEMMA_PROVIDER=ollama
GEMMA_MODEL=gemma3:4b
# Option 1 — hosted inference (Google AI for Developers)
#   https://ai.google.dev/gemma
GOOGLE_AI_API_KEY=
GOOGLE_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Option 2 — self-hosted (Ollama)
#   https://docs.ollama.com/
OLLAMA_BASE_URL=http://127.0.0.1:11434
GEMMA_TIMEOUT_MS=30000
GEMMA_MAX_OUTPUT_TOKENS=1024

# --- Cultural data sources ---------------------------------------------------
WIKIPEDIA_API_URL=https://en.wikipedia.org/w/api.php
WIKIDATA_API_URL=https://www.wikidata.org/w/api.php
# Wikimedia requires a descriptive User-Agent with contact details.
WIKIMEDIA_USER_AGENT=ECHOES/0.1 (https://example.org/echoes; contact@example.org)

# --- Map tiles ---------------------------------------------------------------
# Public OSM tiles are fine for development but NOT an unrestricted production
# service. Point this at your own tile server or a commercial provider.
VITE_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors

# --- Routing -----------------------------------------------------------------
# "osrm" (GraphHopper-compatible OSRM HTTP API) or "graphhopper".
# The public OSRM demo server is for evaluation only — self-host for production.
ROUTING_PROVIDER=osrm
OSRM_BASE_URL=https://router.project-osrm.org
GRAPHHOPPER_API_KEY=
GRAPHHOPPER_BASE_URL=https://graphhopper.com/api/1
ROUTING_TIMEOUT_MS=8000

# --- ALATPay (payments) ------------------------------------------------------
# Docs: https://docs.alatpay.ng/  |  Developer portal: https://developer.alatpay.ng/
# Sandbox and live use different hosts and credentials — never mix them.
ALATPAY_ENV=sandbox
ALATPAY_BASE_URL=https://api.alatpay.com
ALATPAY_PUBLIC_KEY=
ALATPAY_SECRET_KEY=
ALATPAY_BUSINESS_ID=
# Where ALATPay redirects the customer after checkout.
ALATPAY_CALLBACK_URL=http://localhost:5173/experiences/booking/return
# Shared secret used to validate inbound webhook signatures.
ALATPAY_WEBHOOK_SECRET=
# REST paths, taken verbatim from https://docs.alatpay.ng/ for YOUR merchant
# account. ECHOES deliberately has no defaults here: it will never call an
# endpoint that was not explicitly configured. Leave blank until confirmed.
#   ALATPAY_INIT_PATH   example shape: /api/v1/merchant/checkout/initialise
#   ALATPAY_VERIFY_PATH must contain the :reference placeholder
#                       example shape: /api/v1/merchant/transactions/:reference
ALATPAY_INIT_PATH=
ALATPAY_VERIFY_PATH=
# When true, a non-live environment may issue a clearly-labelled SIMULATED
# checkout so the booking flow can be exercised without merchant credentials.
# Simulation is always disabled when ALATPAY_ENV=live.
ALATPAY_ALLOW_SIMULATION=false
CURRENCY=NGN

# --- Client ------------------------------------------------------------------
# Leave empty in dev: Vite proxies /api to the API server.
VITE_API_BASE_URL=
