# ============================================================================
# ECHOES — environment configuration
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# Anything prefixed with VITE_ is shipped to the browser: never put secrets there.
# ============================================================================

# --- Server -----------------------------------------------------------------
NODE_ENV=development
PORT=8787
# Comma-separated list of allowed browser origins (CORS).
# Include your Vercel frontend and any local dev origins you use.
CORS_ORIGINS=http://localhost:5173,https://echoes-1.vercel.app

# --- Database (PostgreSQL + PostGIS + Prisma) --------------------------------
# When DATABASE_URL is unset the API runs on an in-memory repository seeded from
# /data so that discovery, moderation and booking flows stay testable offline.
# Leave this blank for a local/offline dev run unless you have a Postgres instance.
#
# For a durable local stack:  docker compose up -d   (see docker-compose.yml)
# then apply the schema with:  npm --workspace server run db:migrate:dev -- --name init
# and seed it with:            npm --workspace server run db:seed
#
# The credentials below match the local compose service; change them for anything
# that is not a throwaway development database.
DATABASE_URL=

# --- Authentication ----------------------------------------------------------
# HS256 signing secret for user sessions. Generate: openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-string
# Shared secret required by /api/admin/* endpoints (admin token auth).
ADMIN_API_TOKEN=replace-with-an-admin-token
# Absolute base URL of the web app. Password-reset links are built from it.
APP_BASE_URL=http://localhost:5173

# --- Outbound email (SendByte) -----------------------------------------------
# Transport: "log" (write messages to the API log — no provider needed),
# "sendbyte" (post to SendByte's transactional API), or "none" (refuse to send).
# "log" is the default so reset flows work locally without an account.
MAIL_TRANSPORT=log
# The sending domain must be verified before a live key can deliver mail: add it
# with POST /v1/domains, publish the SPF and DKIM records it returns, then verify.
# https://docs.sendbyte.africa/guides/domains
EMAIL_FROM=ECHOES <no-reply@your-verified-domain>
# Required only when MAIL_TRANSPORT=sendbyte.
# Sandbox keys start with sk_test_ (they capture mail instead of delivering it, and
# the app reports them as sandboxed, never as delivered); live keys start sk_live_.
SENDBYTE_API_KEY=
SENDBYTE_BASE_URL=https://api.sendbyte.africa

# --- Uploads -----------------------------------------------------------------
# Local image storage for guide photographs. The file type is decided from the
# file's own bytes, never from the name the client sent.
# NOTE: local disk is right for one instance. A multi-instance deployment needs
# object storage, because a file written on one host is invisible to the others.
UPLOADS_DIR=uploads
UPLOADS_PUBLIC_PATH=/uploads
UPLOADS_MAX_BYTES=5242880

# --- AI model (PRIMARY AI MODEL) ---------------------------------------------
# Provider: "openai" (cheap hosted inference via GPT-4o mini),
#           "google" (Google AI Studio/Gemma), "ollama" (self-hosted/local),
#           or "none" (offline grounded retrieval only).
GEMMA_PROVIDER=openai
GEMMA_MODEL=gpt-4o-mini
# Option 1 — OpenAI (cheap hosted model)
# https://platform.openai.com/
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Option 2 — hosted inference (Google AI for Developers)
#   https://ai.google.dev/gemma
GOOGLE_AI_API_KEY=
GOOGLE_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Option 3 — self-hosted (Ollama)
#   https://docs.ollama.com/
OLLAMA_BASE_URL=http://127.0.0.1:11434
GEMMA_TIMEOUT_MS=30000
GEMMA_MAX_OUTPUT_TOKENS=1024

# --- Cultural data sources ---------------------------------------------------
WIKIPEDIA_API_URL=https://en.wikipedia.org/w/api.php
WIKIDATA_API_URL=https://www.wikidata.org/w/api.php
# Wikimedia requires a descriptive User-Agent with contact details.
WIKIMEDIA_USER_AGENT=ECHOES/0.1 (https://example.org/echoes; contact@example.org)

# --- Map tiles ---------------------------------------------------------------
# Public OSM tiles are fine for development but NOT an unrestricted production
# service. Point this at your own tile server or a commercial provider.
VITE_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

# --- Contact -----------------------------------------------------------------
# Shown on the public contact page. Leave empty and the page says no address is
# configured rather than displaying an invented one.
VITE_CONTACT_EMAIL=

# --- Routing -----------------------------------------------------------------
# "osrm" (GraphHopper-compatible OSRM HTTP API) or "graphhopper".
# The public OSRM demo server is for evaluation only — self-host for production.
ROUTING_PROVIDER=osrm
OSRM_BASE_URL=https://router.project-osrm.org
GRAPHHOPPER_API_KEY=
GRAPHHOPPER_BASE_URL=https://graphhopper.com/api/1
ROUTING_TIMEOUT_MS=8000

# --- ALATPay (payments) ------------------------------------------------------
# Docs: https://docs.alatpay.ng/  |  Developer portal: https://developer.alatpay.ng/
# Sandbox and live use different hosts and credentials — never mix them.
ALATPAY_ENV=sandbox
ALATPAY_BASE_URL=https://api.alatpay.com
ALATPAY_PUBLIC_KEY=815dc3e31535442f9e68ea09aec6d6a9
ALATPAY_SECRET_KEY=f8055f60215642bc8ccf5e82ba77e80b
ALATPAY_BUSINESS_ID=d40830d0-92de-46ec-92a9-848209124619
# Where ALATPay redirects the customer after checkout.
ALATPAY_CALLBACK_URL=http://localhost:5173/experiences/booking/return
# Shared secret used to validate inbound webhook signatures.
ALATPAY_WEBHOOK_SECRET=f7ee1b61a4085c50d37738883270cbdb
# REST paths, taken verbatim from https://docs.alatpay.ng/ for YOUR merchant
# account. ECHOES will never invent an endpoint; these must match the merchant
# account configuration and must include the :reference placeholder in the
# verify path. Common shape from ALATPay merchant docs:
#   ALATPAY_INIT_PATH=/api/v1/merchant/checkout/initialise
#   ALATPAY_VERIFY_PATH=/api/v1/merchant/transactions/:reference
ALATPAY_INIT_PATH=/api/v1/merchant/checkout/initialise
ALATPAY_VERIFY_PATH=/api/v1/merchant/transactions/:reference
# When true, a non-live environment may issue a clearly-labelled SIMULATED
# checkout so the booking flow can be exercised without merchant credentials.
# Simulation is always disabled when ALATPAY_ENV=live.
ALATPAY_ALLOW_SIMULATION=false
CURRENCY=NGN

# --- Client ------------------------------------------------------------------
# The ALATPay checkout widget runs in the browser, so these must be exposed to
# Vite with the VITE_ prefix. Keep the same values as the server-side keys.
VITE_ALATPAY_PUBLIC_KEY=815dc3e31535442f9e68ea09aec6d6a9
VITE_ALATPAY_BUSINESS_ID=d40830d0-92de-46ec-92a9-848209124619
# Leave empty in dev: Vite proxies /api to the API server.
VITE_API_BASE_URL=

# --- First-party analytics, admin access and AI budget -----------------------
# ECHOES collects its own usage statistics. No third-party analytics provider is
# used, and no message contents, credentials or precise locations are collected.

# The timezone every day boundary, "today" figure and chart axis is measured in.
ANALYTICS_TIMEZONE=Africa/Lagos
# Raw events older than this are pruned by the API (audit and payment rows are
# never pruned).
ANALYTICS_RETENTION_DAYS=400
# When true, the browser tracker waits for an explicit opt-in before sending
# anything, and a consent notice is shown.
ANALYTICS_REQUIRE_CONSENT=false

# Extra gate on the admin console. The shared ADMIN_API_TOKEN above still works
# as break-glass access; when this list is set, an admin/moderator SESSION must
# also match one of these addresses. Roles are never self-assignable.
ADMIN_EMAILS=

# AI spend guard rails, in USD micros (1_000_000 = $1). Costs shown in the
# console are estimates from published token prices, not provider invoices.
AI_DAILY_BUDGET_MICROS=5000000
AI_MONTHLY_BUDGET_MICROS=50000000
AI_BUDGET_ALERT_PERCENT=80
